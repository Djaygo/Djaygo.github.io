---
import { Icon } from 'astro-icon/components';
---

<div class="text-center mb-8 sm:mb-12 animate-fade-in">
  <a href="/" id="site-header-link" class="inline-block group">
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 transition-all duration-300 group-hover:tracking-tight">
      <span class="text-accent dark:text-white bg-gradient-to-r from-accent to-primary bg-clip-text group-hover:text-transparent transition-all duration-500">Djaygo</span>'s Digital Garden
    </h1>
  </a>
  <p class="text-xl text-muted max-w-xl mx-auto w-fit">
    A space for thoughts, notes, and ideas to grow.
  </p>
  <nav aria-label="Main" class="flex justify-center items-center gap-x-2 gap-y-1 mt-4 flex-wrap">
    <a href="/about" class="nav-link inline-flex items-center gap-2 px-3 py-3 text-sm text-muted hover:text-primary transition-all duration-300 hover:scale-105">
      <Icon name="tabler:user" class="w-4 h-4" aria-hidden="true" />
      About
    </a>
    <a href="/tags" class="nav-link inline-flex items-center gap-2 px-3 py-3 text-sm text-muted hover:text-primary transition-all duration-300 hover:scale-105">
      <Icon name="tabler:hash" class="w-4 h-4" aria-hidden="true" />
      Tags
    </a>
    <a href="/search" class="nav-link inline-flex items-center gap-2 px-3 py-3 text-sm text-muted hover:text-primary transition-all duration-300 hover:scale-105">
      <Icon name="tabler:search" class="w-4 h-4" aria-hidden="true" />
      Search
    </a>
    <a href="https://github.com/Djaygo" target="_blank" rel="noopener noreferrer" class="nav-link inline-flex items-center gap-2 px-3 py-3 text-sm text-muted hover:text-primary transition-all duration-300 hover:scale-105">
      <Icon name="tabler:brand-github" class="w-4 h-4" aria-hidden="true" />
      GitHub
    </a>
    <div id="theme-pill" class="inline-flex items-center bg-gray-100 dark:bg-slate-800 rounded-full p-0.5 gap-0.5">
      <button type="button" id="theme-toggle-light" class="inline-flex items-center justify-center w-10 h-10 rounded-full text-muted transition-all duration-200 cursor-pointer" title="Light mode" aria-label="Light mode" aria-pressed="false"><Icon name="tabler:sun" class="w-5 h-5" aria-hidden="true" /></button>
      <button type="button" id="theme-toggle-dark" class="inline-flex items-center justify-center w-10 h-10 rounded-full text-muted transition-all duration-200 cursor-pointer" title="Dark mode" aria-label="Dark mode" aria-pressed="false"><Icon name="tabler:moon" class="w-5 h-5" aria-hidden="true" /></button>
    </div>
  </nav>
</div>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.6s ease-out forwards;
  }

  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 6px;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--aw-color-primary), var(--aw-color-accent));
    transition: all 0.3s ease-out;
    transform: translateX(-50%);
    border-radius: 1px;
  }

  .nav-link:hover::after {
    width: 100%;
  }
</style>

<script>
  function initHeaderLink() {
    const headerLink = document.getElementById('site-header-link');
    if (!headerLink) return;

    let isNavigating = false;

    headerLink.addEventListener('click', (e) => {
      // Prevent navigation if already on home page
      if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
        e.preventDefault();
        return;
      }

      // Debounce rapid clicks
      if (isNavigating) {
        e.preventDefault();
        return;
      }

      isNavigating = true;
      setTimeout(() => {
        isNavigating = false;
      }, 1000);
    });
  }

  // Run on load and after view transitions
  initHeaderLink();
  document.addEventListener('astro:after-swap', initHeaderLink);
</script>

<script>
  function initThemePill() {
    const lightBtn = document.getElementById('theme-toggle-light');
    const darkBtn = document.getElementById('theme-toggle-dark');
    if (!lightBtn || !darkBtn) return;

    const activeClasses = ['bg-white', 'shadow-sm'];
    const activeDarkClasses = ['bg-slate-600', 'shadow-sm'];

    function updatePill() {
      const isDark = document.documentElement.classList.contains('dark');

      // Remove active state from both buttons
      lightBtn.classList.remove(...activeClasses, ...activeDarkClasses);
      darkBtn.classList.remove(...activeClasses, ...activeDarkClasses);

      lightBtn.setAttribute('aria-pressed', String(!isDark));
      darkBtn.setAttribute('aria-pressed', String(isDark));

      // Add active state to current theme
      if (isDark) {
        darkBtn.classList.add(...activeDarkClasses);
      } else {
        lightBtn.classList.add(...activeClasses);
      }
    }

    function setTheme(theme: 'light' | 'dark') {
      document.dispatchEvent(new CustomEvent('site-theme-request', { detail: { theme } }));
      updatePill();
    }

    lightBtn.addEventListener('click', () => setTheme('light'));
    darkBtn.addEventListener('click', () => setTheme('dark'));

    updatePill();

    const observer = new MutationObserver(updatePill);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  initThemePill();
  document.addEventListener('astro:after-swap', initThemePill);
</script>
